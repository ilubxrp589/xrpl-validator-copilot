# Copy to .env (the CLI/server read process env; use `node --env-file=.env ...`
# or `set -a; . ./.env; set +a` to load).

# No key needed by default: the 'cli' provider uses your `claude` account auth.
# Only set these to use the Anthropic SDK path instead:
# COPILOT_PROVIDER=api
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults are examples — set these for your own node):
# COPILOT_API_BASE=http://your-validator-host:3777      # validator API (direct; independent of dashboard)
# COPILOT_METRICS_BASE=http://your-validator-host:3779   # system-resources sidecar
# COPILOT_RIPPLED_RPC=http://localhost:5005        # local rippled (source node)
# COPILOT_MODEL=claude-opus-4-8                     # or claude-sonnet-4-6 (cheaper/faster), claude-haiku-4-5-20251001
# COPILOT_MAX_TOKENS=1500
# COPILOT_PORT=3780                                 # server.mjs listen port
# COPILOT_DIVERGENCES_LOG=/path/to/xrpl-validator/logs/divergences.jsonl

# Watchdog alerts (Phase 2) — leave channel empty to disable:
# COPILOT_ALERT_CHANNEL=telegram          # 'telegram' or 'webhook'
# COPILOT_TG_TOKEN=123456:ABC...           # Telegram bot token (SECRET)
# COPILOT_TG_CHAT=123456789                # your Telegram chat id
# COPILOT_ALERT_WEBHOOK=https://...         # for channel=webhook (Slack/Discord/ntfy/custom)
# COPILOT_ALERT_FORMAT=json                 # webhook format: json | slack | discord | ntfy
# COPILOT_ALERT_COOLDOWN_MIN=15
